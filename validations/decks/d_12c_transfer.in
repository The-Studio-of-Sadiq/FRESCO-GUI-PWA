Deuteron Stripping 12C(d,p)13C at 12.0 MeV (DWBA)
NAMELIST
 &FRESCO hcm=0.04 rmatch=20
     jtmin=0.0 jtmax=31 absend=-1
     thmin=0 thmax=120 thinc=2
     iter=1 chans=1 smats=2 xstabl=1 kqmax=1
     elab(1)=12 /   ! rmax=30 lmax=30

 &PARTITION namep='d' massp=2 zp=1 nex=1 namet='12C' masst=12 zt=6 qval=0 /   ! d + 12C
 &STATES jp=1 bandp=1 ep=0 cpot=1 jt=0 bandt=1 et=0 /   ! d + 12C(g.s.)
 &PARTITION namep='p' massp=1 zp=1 nex=1 namet='13C' masst=13 zt=6 qval=2.722 /   ! p + 13C
 &STATES jp=0.5 bandp=1 ep=0 cpot=2 jt=0.5 bandt=1 et=0 /   ! p + 13C(1/2+ g.s.)
 &partition /

 &pot kp=1 at=12 ap=0 rc=1.3 v=88 rv=1.15 av=0.72 w=0 rw=1.15 aw=0.72 wd=14.2 wdr=1.34 wda=0.68 vso=6 rso=1 aso=0.6 /   ! Deuteron Optical Potential
 &pot kp=2 at=13 ap=0 rc=1.25 v=54 rv=1.25 av=0.65 w=2 rw=1.25 aw=0.65 wd=9.5 wdr=1.25 wda=0.58 vso=6 rso=1.1 aso=0.6 /   ! Proton Optical Potential in Exit Channel
 &pot kp=3 at=12 ap=0 rc=0.0001 v=48.5 rv=1.25 av=0.65 w=0 rw=1.25 aw=0.65 wd=0 wdr=1.25 wda=0.65 vso=6 rso=1.1 aso=0.6 /   ! Neutron + 12C Core Bound State Potential
 &pot /

 &overlap kn1=1 ic1=1 ic2=2 in=2 kind=0 nn=2 l=0 sn=0.5 j=0.5 kbpot=3 be=4.946 isc=1 /   ! 2s1/2 Single-Particle Neutron State in 13C
 &overlap /

 &coupling icto=2 icfrom=1 kind=5 p1=-122.5 p2=0.746 /
   &cfp in=-2 ib=1 ia=1 kn=1 a=0.9219544457 /
 &coupling /
